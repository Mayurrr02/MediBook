# Database Configuration
MONGO_URI=mongodb://localhost:27017/medibook

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRE_HOURS=24

# Redis Configuration (Distributed Locking, Rate Limiting, Celery Broker)
REDIS_URL=redis://localhost:6379/0
SLOT_LOCK_TTL_SECONDS=300
DEFAULT_SLOT_DURATION_MINUTES=30

# Celery Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Waitlist Configuration
WAITLIST_CLAIM_WINDOW_MINUTES=15

# Notification System
NOTIFICATION_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@medibook.health

# Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PREMIUM_AMOUNT_PAISE=49900

# AI / LLM Integration (Phase 3)
GEMINI_API_KEY=

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
